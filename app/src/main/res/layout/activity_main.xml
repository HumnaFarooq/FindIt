<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FindIt 🎓"
            android:textColor="#153448"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hello, Student!"
            android:textColor="#153448"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Lost something? Let's help you find it."
            android:textColor="#64748B"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:hint="Search items..."
            android:inputType="text"
            android:padding="12dp"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2C3E50"
            android:text="🔍 Search &amp; Filter Items"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnReportItem"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#176B78"
            android:text="Report Lost / Found Item"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Explore Items"
            android:textColor="#153448"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnLostItems"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#DCEEF2"
            android:text="Lost Items"
            android:textAllCaps="false"
            android:textColor="#153448"/>

        <Button
            android:id="@+id/btnFoundItems"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DDF4E4"
            android:text="Found Items"
            android:textAllCaps="false"
            android:textColor="#153448"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Recently Reported"
            android:textColor="#153448"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRecentItem1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="🎒 Black Backpack\nLocation: University Library\nStatus: LOST"
            android:textColor="#153448"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvRecentItem2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="🔑 Set of Keys\nLocation: Computer Lab\nStatus: FOUND"
            android:textColor="#153448"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btnMyReports"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#153448"
            android:text="My Reports"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
