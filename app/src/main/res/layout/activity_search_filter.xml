<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBackSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#DCEEF2"
                android:text="← Home"
                android:textAllCaps="false"
                android:textColor="#153448" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Search &amp; Filter"
                android:textColor="#153448"
                android:textSize="26sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etSearchKeyword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:hint="Enter item name or keyword"
            android:inputType="text"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Item Category"
            android:textColor="#153448"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/rgCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbAllItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Items"/>

            <RadioButton
                android:id="@+id/rbLostItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lost Items"/>

            <RadioButton
                android:id="@+id/rbFoundItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Found Items"/>

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Campus Location"
            android:textColor="#153448"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etFilterLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="Enter location (e.g. Library, Lab)"
            android:inputType="text"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#176B78"
            android:text="Apply Filters"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnClearFilter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#DCEEF2"
            android:text="Clear Filters"
            android:textColor="#153448"
            android:textAllCaps="false"/>

        <!-- Matching Items Section -->
        <TextView
            android:id="@+id/tvMatchingItemsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Matching Items"
            android:textColor="#153448"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvNoMatchingItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="No matching items found for these filters."
            android:textColor="#64748B"
            android:textSize="15sp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/llMatchingItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>
